            "$ref": "Organization"
          }
        },
        "languageCode": {
          "type": "string",
          "description": "Default listing language in BCP 47 format."
        },
        "packageName": {
          "readOnly": true,
          "type": "string",
          "description": "Output only. Package name of the created Android app. Only present in the API response."
        }
      },
      "id": "CustomApp",
      "type": "object"
    }
