              },
              "response": {
                "$ref": "CustomApp"
              },
              "id": "playcustomapp.accounts.customApps.create",
              "flatPath": "playcustomapp/v1/accounts/{account}/customApps",
              "description": "Creates a new custom app.",
              "mediaUpload": {
