                  "description": "Developer account ID.",
                  "required": true,
                  "type": "string"
                }
              },
              "mediaUpload": {
                "maxSize": "10737418240",
                "accept": [
                  "*/*"
                ],
                "protocols": {
                  "resumable": {
                    "path": "/resumable/upload/playcustomapp/v1/accounts/{account}/customApps",
                    "multipart": true
                  },
                  "simple": {
                    "path": "/upload/playcustomapp/v1/accounts/{account}/customApps",
                    "multipart": true
                  }
                }
              },
              "request": {
                "$ref": "CustomApp"
              }
            }
