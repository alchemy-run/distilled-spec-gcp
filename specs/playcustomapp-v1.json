  "protocol": "rest",
  "resources": {
    "accounts": {
      "resources": {
        "customApps": {
          "methods": {
            "create": {
              "id": "playcustomapp.accounts.customApps.create",
              "parameterOrder": [
                "account"
              ],
              "mediaUpload": {
                "accept": [
                  "*/*"
                ],
                "protocols": {
                  "resumable": {
                    "multipart": true,
                    "path": "/resumable/upload/playcustomapp/v1/accounts/{account}/customApps"
                  },
