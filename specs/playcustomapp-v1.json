      "resources": {
        "customApps": {
          "methods": {
            "create": {
              "flatPath": "playcustomapp/v1/accounts/{account}/customApps",
              "httpMethod": "POST",
              "supportsMediaUpload": true,
              "mediaUpload": {
                "accept": [
                  "*/*"
                ],
                "protocols": {
                  "resumable": {
                    "multipart": true,
                    "path": "/resumable/upload/playcustomapp/v1/accounts/{account}/customApps"
                  },
                  "simple": {
                    "multipart": true,
                    "path": "/upload/playcustomapp/v1/accounts/{account}/customApps"
                  }
                },
                "maxSize": "10737418240"
              },
              "parameters": {
                "account": {
                  "type": "string",
