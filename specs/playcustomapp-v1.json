          "methods": {
            "create": {
              "id": "playcustomapp.accounts.customApps.create",
              "path": "playcustomapp/v1/accounts/{account}/customApps",
              "request": {
                "$ref": "CustomApp"
              },
              "flatPath": "playcustomapp/v1/accounts/{account}/customApps",
              "mediaUpload": {
                "protocols": {
