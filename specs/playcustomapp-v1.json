        "https://www.googleapis.com/auth/androidpublisher": {
          "description": "View and manage your Google Play Developer account"
        }
      }
    }
  },
  "batchPath": "batch",
  "ownerDomain": "google.com",
  "resources": {
    "accounts": {
      "resources": {
