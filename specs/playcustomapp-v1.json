            "$ref": "Organization"
          }
        },
        "title": {
          "description": "Title for the Android app.",
          "type": "string"
        },
        "packageName": {
          "description": "Output only. Package name of the created Android app. Only present in the API response.",
          "type": "string",
          "readOnly": true
        },
