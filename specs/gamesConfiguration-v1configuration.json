        "token": {
          "type": "string",
          "description": "The token for this resource."
        },
        "initialState": {
          "enumDescriptions": [
            "Default value. This value is unused.",
            "Achievement is hidden.",
            "Achievement is revealed."
          ],
          "type": "string",
          "enum": [
            "INITIAL_STATE_UNSPECIFIED",
