          "parameters": {
            "name": {
              "location": "path",
              "type": "string",
              "required": true,
              "pattern": "^shelves/[^/]+$",
              "description": "Required. The name of the shelf to retrieve."
            }
          }
        },
        "list": {
          "path": "v1/shelves",
          "parameterOrder": [],
          "parameters": {
            "pageSize": {
