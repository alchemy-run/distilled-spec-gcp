          },
          "id": "siteVerification.webResource.get",
          "parameterOrder": [
            "id"
          ]
        },
        "getToken": {
          "request": {
            "$ref": "SiteVerificationWebResourceGettokenRequest"
          },
          "description": "Get a verification token for placing on a website or domain.",
          "scopes": [
            "https://www.googleapis.com/auth/siteverification",
